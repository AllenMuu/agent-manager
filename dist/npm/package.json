{
  "name": "@allenmuu/agent-manager",
  "version": "0.0.0",
  "description": "Run the Agent Manager Go CLI with npx, without a Go toolchain",
  "bin": {
    "agent-manager": "bin/agent-manager.js"
  },
  "scripts": {
    "postinstall": "node install.js",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "node -e \"require('./install.js').buildUrl(require('./package.json').version, 'checksums.txt')\""
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "install.js",
    "bin/agent-manager.js",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AllenMuu/agent-manager.git"
  }
}
